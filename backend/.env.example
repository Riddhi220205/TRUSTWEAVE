# Sepolia RPC endpoint (Alchemy / Infura / public node)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of the wallet that DEPLOYED the contract (only the owner can write)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Deployed IoTTrust contract address on Sepolia
CONTRACT_ADDRESS=0xYourContractAddress
PORT=3000
# Optional: seconds-level read cache (ms). Raise it if your RPC plan is tight.
CACHE_TTL_MS=15000
